# Optional settings for the self-hosted server (compose.yaml).
# Copy to selfhost.env and edit. Without the file the defaults below apply.
#
# GAME_ENV, DOMAIN and TURNSTILE_SITE_KEY are pinned in compose.yaml on
# purpose, so setting them here has no effect.
#
# Don't set SUBDOMAIN, GAME_HOST, GAME_DOMAIN, SITE_HOST or ALLOWED_FLARES.
# The first four make the server wait for approval from the official API
# before it runs public lobbies, and ALLOWED_FLARES turns away anonymous
# players.

# Game worker processes. Each holds its own games. Use 1 on a machine with
# 4 GB of RAM or less.
NUM_WORKERS=2

# Letter that tags game IDs from this server.
INSTANCE_LETTER=a
